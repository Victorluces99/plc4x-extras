        <groupId>org.apache.plc4x.malbec.projecttype</groupId>
        <artifactId>projecttype</artifactId>
        <version>1.1.0-SNAPSHOT</version>
    </parent>
    
    <artifactId>HMIPanelSubprojectCategory</artifactId>
    <packaging>nbm</packaging>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.netbeans.utilities</groupId>
                <artifactId>nbm-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <publicPackages>
                        <publicPackage>org.apache.plc4x.malbec.projecttype.panelcategory</publicPackage>
                        <publicPackage>org.apache.plc4x.malbec.projecttype.panelcategory.nodes</publicPackage>
                        <publicPackage>org.apache.plc4x.malbec.projecttype.panelcategory.panel</publicPackage>
                        <publicPackage>org.plcopen.xml.*</publicPackage>
                    </publicPackages>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.xmlbeans</groupId>
                <artifactId>xmlbeans</artifactId>
                <version>${xmlbeans.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Directorio donde se encuentra el XSD -->
                    <schemaDirectory>src/main/schema</schemaDirectory>
                    
                    <repackage>org.apache.plc4x.malbec.projecttype.hmipanelsubprojectcategory.metadata</repackage>
                    <noUpa>true</noUpa>
                    <noPvr>true</noPvr>
                </configuration>
            </plugin>
        </plugins>
    </build>
